   "source": [
    "# Sum of Series"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cdd1278b",
   "metadata": {},
   "outputs": [],
   "source": [
    "def sum_of_series(n):\n",
    "    sum = 0\n",
    "    for i in range(1, n + 1):\n",
    "        sum += i\n",
    "    return sum"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9cc88afa",
   "metadata": {},
   "outputs": [],
   "source": [
    "n = 7"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e067685a",
   "metadata": {},
   "outputs": [],
   "source": [
    "print(sum_of_series(n))"
   ]
  }
