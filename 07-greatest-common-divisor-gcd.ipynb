   "source": [
    "# Greatest Common Divisor"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5e123b83",
   "metadata": {},
   "outputs": [],
   "source": [
    "def gcd(a:int, b:int) -> int:\n",
    "    \n",
    "    if a < b:\n",
    "        a, b = b, a\n",
    "    \n",
    "    while b > 0:\n",
    "        a, b = b, a % b\n",
    "    \n",
    "    return a"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "adb582ea",
   "metadata": {},
   "outputs": [],
   "source": [
    "a = 348\n",
    "b = 1060"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "573d10c6",
   "metadata": {},
   "outputs": [],
   "source": [
    "print(f'GCD({a}, {b}) = {gcd(a, b)}')"
   ]
  }
